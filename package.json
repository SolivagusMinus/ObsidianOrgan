{
  "name": "obsidian-folder-hub",
  "version": "1.9.0",
  "description": "Auto-creates an index note in every folder and keeps [[links]] to all files inside it.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.config.mjs test && node --test test-dist/render.test.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "folder",
    "index",
    "moc"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "~5.9.0"
  }
}
